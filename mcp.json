{
  "mcpServers": {
    "ethmumbai-yield-router-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Arbitrum / Ethereum L2",
        "PROJECT_TICKER": "EMYIELD"
      },
      "tools": [
        {
          "name": "verify_emyield_invariants",
          "description": "Verifies deterministic invariants for ETHMumbai Yield Router AI on Arbitrum / Ethereum L2."
        },
        {
          "name": "execute_emyield_action",
          "description": "Executes authenticated DeFi state transition."
        }
      ]
    }
  }
}